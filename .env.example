APP_NAME=Information Entry Agent
APP_ENV=development
APP_PORT=8000

QIXIN_APP_KEY=
QIXIN_SECRET_KEY=
QIXIN_BASE_URL=https://api.qixin.com
QIXIN_TIMEOUT_SECONDS=15

OPENAI_TEMPERATURE=0
DS_BASE_URL=https://api.deepseek.com
DS_API_KEY=
DS_MODEL=deepseek-v4-flash
DS_INTENT_MODEL=deepseek-v4-flash
DS_TEMPERATURE=0
LLM_EXTRACTION_ENABLED=true
LLM_EXTRACTION_MAX_TOKENS=800
LLM_INTENT_ENABLED=true
LLM_INTENT_MAX_TOKENS=120

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=agent_db
MYSQL_USER=agent_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_STORE_BACKEND=auto
SESSION_STORE_PREFIX=distributor-agent:session:
SESSION_STORE_TTL_SECONDS=86400
